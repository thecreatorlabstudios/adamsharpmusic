# Set these in Vercel > Project > Settings > Environment Variables. Never commit real values.
# Make logins with:  node tools/hash.mjs joshua   and   node tools/hash.mjs adam
# then join the printed lines with a semicolon.
SITE_USERS=joshua:SALT:HASH;adam:SALT:HASH
# Random text, 32+ characters.
SESSION_SECRET=
# Login on (default). false opens the site to everyone.
REQUIRE_LOGIN=true
# Hours a sign-in lasts (optional).
SESSION_HOURS=12
